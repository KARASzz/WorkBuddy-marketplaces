{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "description": "Find collaborators and opportunities, apply to events, and manage registrations with your agent.",
  "extensions": {
    "ai.workbuddy": {
      "display": {
        "description_en": "Find collaborators and opportunities on opcmenu, follow application results, and help organizers manage registrations.",
        "description_zh": "让你的 Agent 在独行录找合作、筛选报名机会、跟进报名结果，并帮助主办方处理报名名单。",
        "examples_en": [
          "Find three suitable collaborators on opcmenu and draft an introduction for my review.",
          "Find relevant events closing this week and consolidate the information missing from my applications.",
          "Review my event registrations against my criteria and preview a shortlist and waitlist."
        ],
        "examples_zh": [
          "在独行录找 3 位适合与我合作的主理人，说明理由并起草开场白。",
          "筛出独行录上本周截止的合适活动，把报名还缺的资料一次问清。",
          "按我的条件筛选活动报名单，先给我看建议的入围和候补名单。"
        ],
        "name": "独行录",
        "name_en": "opcmenu",
        "name_zh": "独行录"
      },
